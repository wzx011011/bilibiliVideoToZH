{
  "manifest_version": 3,
  "name": "豆包课程配音助手",
  "version": "2.0.0",
  "description": "抓取豆包朗读凭据，并按队列自动发送课程字幕分块",
  "permissions": ["activeTab", "cookies", "webRequest", "storage"],
  "host_permissions": ["*://*.doubao.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*.doubao.com/*"],
    "js": ["sender-core.js", "relay.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["inject.js"],
    "matches": ["*://*.doubao.com/*"]
  }],
  "action": {
    "default_title": "豆包课程配音助手",
    "default_popup": "popup.html"
  }
}
