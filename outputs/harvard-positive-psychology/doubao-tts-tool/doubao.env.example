# 复制本文件为 doubao.env (同目录) 或导出为环境变量后填入真实值。
# doubao.env 含账号凭据,切勿提交到 git(已在 .gitignore 中按需忽略)。

# 浏览器抓包得到的完整 cookie 串: sessionid=...; sid_tt=...; uid_tt=...; ttwid=...; passport_csrf_token=...
DOUBAO_COOKIE="sessionid=XXXX; sid_tt=XXXX; uid_tt=XXXX; ttwid=XXXX; passport_csrf_token=XXXX"

# 设备 / 账号参数(从抓包来)
DOUBAO_DEVICE_ID="0000000000000000000"
DOUBAO_WEB_ID="0000000000000000000"
DOUBAO_TEA_UUID="0000000000000000000"
DOUBAO_WEB_TAB_ID="00000000-0000-0000-0000-000000000000"
DOUBAO_API_APP_KEY="XXXXXXXXXXXXXXXX"
DOUBAO_UID="000000000000000"

# 朗读目标(每次朗读改这里)
DOUBAO_MESSAGE_ID="00000000000000000000"
DOUBAO_CONVERSATION_ID="00000000000000000000"
DOUBAO_QUESTION_ID="00000000000000000000"
DOUBAO_SECTION_ID="00000000000000000000"
DOUBAO_REPLY_UNIQUE_KEY="00000000-0000-0000-0000-000000000000"
